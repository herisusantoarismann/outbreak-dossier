# =============================================================================
# OUTBREAK DOSSIER - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CANONICAL APP URL (Optional - defaults to https://outbreak-dossier.org)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# 2. SENTRY ERROR MONITORING & SOURCE MAPS (Optional for local development)
# -----------------------------------------------------------------------------
# Client & Server DSN (Safe to expose to client browser via NEXT_PUBLIC_)
NEXT_PUBLIC_SENTRY_DSN=

# Build-time / Server-only configuration (DO NOT prefix with NEXT_PUBLIC_)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
